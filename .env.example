# Copy this file to .env and fill in real values:  cp .env.example .env
# NEVER commit the real .env file.

# Django
DEBUG=False
SECRET_KEY=
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Database (PostgreSQL)
DB_NAME=rice_trading_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Set True for managed databases such as Supabase, Neon or AWS RDS
DB_SSL=False

# Subscription
TRIAL_DAYS=14
SUBSCRIPTION_WARN_DAYS=7

# Razorpay (leave empty to record manual/offline payments instead)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (leave EMAIL_HOST empty in development to print emails to the terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
